{
  "manifest_version": 3,
  "name": "PineChar",
  "version": "0.1.0",
  "description": "Intercepts navigations to distracting sites and routes them through a gate page.",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["*://*.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["grant-schema.js", "overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "PineChar — Weekly goals",
    "default_popup": "goals.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["gate.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
